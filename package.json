{
  "name": "usmtcc-website",
  "version": "1.0.0",
  "description": "USM/TCC Tennis Club Website - Full Stack",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}